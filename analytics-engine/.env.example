# Smart Portfolio Advisor - Analytics Engine Environment

# LLM + RAG Advisor Configuration
# Set LLM_API_KEY to enable the AI Wealth Advisor chat layer.
# The provider is auto-detected: keys starting with "AIza" are
# treated as Google Gemini keys; otherwise OpenAI-compatible.

# OpenAI example (default)
# LLM_API_KEY=sk-your-openai-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_MAX_TOKENS=1024

# OpenRouter example
# LLM_API_KEY=sk-or-v1-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-3.5-sonnet

# Google Gemini example (auto-detected from AIza key prefix)
# LLM_API_KEY=AIzaSy-your-gemini-key-here
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash
# LLM_MAX_TOKENS=1024

# Local Ollama example
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
